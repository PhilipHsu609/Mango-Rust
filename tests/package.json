{
  "name": "mango-rust-integration-tests",
  "version": "1.0.0",
  "description": "Integration tests for Mango-Rust",
  "private": true,
  "type": "module",
  "scripts": {
    "build:server": "cargo build --manifest-path ../Cargo.toml --bin mango-rust",
    "test": "npm run build:server && vitest run",
    "test:watch": "npm run build:server && vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.0.0"
  },
  "license": "MIT"
}
